# API
NEXT_PUBLIC_API_BASE_URL=https://api.aparteng.com

# Canonical origin (used for canonical URLs, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://aparte.ng

# Cross-app
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://dashboard.aparte.ng

# Auth (obfuscates the token at rest in sessionStorage; ships in the client
# bundle, so it is not a secret)
NEXT_PUBLIC_TOKEN_SECRET_KEY=

# Integrations
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (production only; consent-gated)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Ads conversion tag, e.g. AW-18420120529. Leave BLANK outside
# production: conversions fired from previews and QA feed the bidding model.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN_DEVELOPMENT=
NEXT_PUBLIC_MIXPANEL_TOKEN_PRODUCTION=
NEXT_PUBLIC_SENTRY_DSN=

# Support
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=