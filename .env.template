# Vite Environment Variables Template
# Copy this to .env, .env.staging, or .env.production

# API Base URL
# Note: For Cloud Build, set _VITE_API_BASE_URL substitution
VITE_API_BASE_URL=https://aparte-api-639323503762.europe-west1.run.app/api/v1

# Security & Tokens
VITE_API_KEY=
VITE_TOKEN_SECRET_KEY=

# Third-party Integrations
VITE_GOOGLE_MAPS_API_KEY=

# Analytics (production only). Leave blank in dev/staging so analytics never
# loads outside production. Set the real values in the production build pipeline.
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# Internal Links
VITE_ADMIN_DASHBOARD_URL=https://dashboard.aparteng.com

# App Metadata
VITE_APP_TITLE=AparteNG

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Support — WhatsApp concierge
# Country code + national number, NO leading + or 00 (e.g. 2348012345678).
# Leave blank to hide every WhatsApp affordance (help FAB + booking CTA).
# Point staging at a test line; set the real business number in production only.
VITE_SUPPORT_WHATSAPP_NUMBER=
