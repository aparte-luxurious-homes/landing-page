# Next.js public environment variables template
# Copy this to .env.local (or set the same names as Vercel project env vars).
# Every name must carry the NEXT_PUBLIC_ prefix: Next inlines these at build
# time. The old VITE_* names are no longer read. See src/config/env.ts.

# API Base URL
NEXT_PUBLIC_API_BASE_URL=https://aparte-api-639323503762.europe-west1.run.app/api/v1

# Site
NEXT_PUBLIC_SITE_URL=https://aparte.ng

# Security & Tokens
NEXT_PUBLIC_TOKEN_SECRET_KEY=

# Third-party Integrations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (production only). Leave blank in dev/staging so analytics never
# loads outside production. Set the real values in the production build pipeline.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Internal Links
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://dashboard.aparteng.com

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Support — WhatsApp concierge (a human)
# Country code + national number, NO leading + or 00 (e.g. 2348012345678).
# Leave blank to hide every support WhatsApp affordance (help FAB + booking CTA).
# Point staging at a test line; set the real business number in production only.
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=

# Booking bot — "Aparte on WhatsApp" (a different number from support)
# Same format as above. Leave blank to hide every "Book on WhatsApp" CTA.
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=
